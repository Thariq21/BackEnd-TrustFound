# --- Server Config ---
PORT=5000
NODE_ENV=development

# --- JWT Secret (Untuk Login Token) ---
# Ganti tulisan acak ini dengan yang lebih rumit nanti
JWT_SECRET=Example

# --- MySQL Database (Data Utama: User, Item, Claim) ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=

# --- MongoDB Database (Data Logs & Audit Trail) ---
# URI Cluster
MONGO_URI=
# Nama Database di Mongo
MONGO_DB_NAME=
